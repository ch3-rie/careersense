@startuml
!include style.puml
title Figure 3b. Use Case Diagram for Password Reset

actor Guest as guest
actor Alumni as alumni

rectangle "CareerSense" {
  usecase "Request password\nreset" as UC05
  usecase "Verify PIN and\nset new password" as UC06
  usecase "Send email" as UC43
}

actor "Email Service" as email

guest --> UC05
alumni --> UC05
UC06 .up.> UC05 : <<extend>>\n[PIN was issued]
UC05 ..> UC43 : <<include>>
UC43 --> email

legend right
  The included email sends a 6-digit PIN.
  The PIN expires after 10 minutes.
endlegend
@enduml
