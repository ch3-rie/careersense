# Copy to backend/.env (or export in your shell) before running the API.

# development | production
ENVIRONMENT=development

# SQLite (default, good for local development)
DATABASE_URL=sqlite:///./careersense.db

# PostgreSQL (required for campus deployment)
# DATABASE_URL=postgresql+psycopg://careersense:careersense@localhost:5432/careersense

# Required in production: a unique value of at least 32 characters.
# In development, an insecure example is accepted with a startup warning, or a
# random key is generated if this is left empty. Do not use the example value live.
SECRET_KEY=

# JWT lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origin(s), comma-separated. Production must list the real frontend URL. No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional single origin. Added to CORS and used for email links when EMAIL_BASE_URL is empty.
FRONTEND_URL=
PUBLIC_APP_URL=http://localhost:5173

# Optional path to the Tesseract binary. Leave empty to use PATH (Render/Linux and a normal Windows install).
TESSERACT_CMD=

# Render sets PORT. Local start scripts fall back to 8000. Do not set this unless you need a custom port.
# PORT=8000

# Optional: Google Gemini for resume extraction. If unset, CareerSense uses the local heuristic parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Uploaded resume storage (relative to the backend folder unless absolute)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# API docs (/docs, /redoc, /openapi.json). Defaults to on in development, off in production.
# ENABLE_DOCS=true

# Optional OAAPS contact shown on the rejected-account page. Leave blank to show office name only.
# OAAPS_EMAIL=
# OAAPS_PHONE=
# OAAPS_HOURS=
# OAAPS_LOCATION=Angeles University Foundation
# OAAPS_OFFICE_NAME=Office of Alumni Affairs and Placement Services

# Transactional email via Resend. Set EMAIL_ENABLED=false for local work without a key.
# Setup: docs/resend-email.md
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=CareerSense
EMAIL_REPLY_TO=
EMAIL_BASE_URL=http://localhost:5173
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=400
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_SCHEDULER_ENABLED=
EMAIL_SCHEDULER_INTERVAL_SECONDS=60
EMAIL_TIMEZONE=Asia/Manila

# Behind a reverse proxy, set this true so rate limits use X-Forwarded-For.
# Leave false unless the proxy is trusted and strips client-supplied X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
RATE_LIMIT_ENABLED=true
